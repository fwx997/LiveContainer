{
  "sourceLanguage": "en",
  "strings": {
    "Another refresh task is in progress. This request was not started. Keep the VPN connected until that task finishes.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another refresh task is in progress. This request was not started. Keep the VPN connected until that task finishes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一个续签任务仍在执行，本次请求未启动。请保持 VPN 连接，等待该任务结束。"
          }
        }
      }
    },
    "Get Refresh Result": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get Refresh Result"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查询本次续签结果"
          }
        }
      }
    },
    "Request ID": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Request ID"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "续签请求 ID"
          }
        }
      }
    },
    "Checks one refresh request without starting another refresh.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks one refresh request without starting another refresh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按请求 ID 查询本次续签结果，不会再次发起续签。"
          }
        }
      }
    },
    "Refresh is preparing or still running. Keep the VPN connected until its final result is available.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh is preparing or still running. Keep the VPN connected until its final result is available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "续签正在准备或仍在执行。请保持 VPN 连接，等待本次续签的最终结果。"
          }
        }
      }
    },
    "This refresh result is missing, expired or unavailable. Keep the VPN connected until you verify the result in SideStore.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This refresh result is missing, expired or unavailable. Keep the VPN connected until you verify the result in SideStore."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次续签结果不存在、已过期或暂时无法读取。确认 SideStore 中的结果前，请保持 VPN 连接。"
          }
        }
      }
    },
    "The refresh finished but its result could not be saved. Check SideStore before disconnecting the VPN.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The refresh finished but its result could not be saved. Check SideStore before disconnecting the VPN."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "续签已结束，但结果未能保存。请先在 SideStore 中确认结果，再断开 VPN。"
          }
        }
      }
    },
    "Return Errors as Result": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": { "state": "translated", "value": "Return Errors as Result" }
        },
        "zh-Hans": {
          "stringUnit": { "state": "translated", "value": "出错时返回结果" }
        }
      }
    },
    "Another refresh task is in progress.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another refresh task is in progress."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一个续签任务正在进行中。"
          }
        }
      }
    },
    "Built-in SideStore did not establish its background connection.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Built-in SideStore did not establish its background connection."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内置 SideStore 未能建立后台连接，请重试。"
          }
        }
      }
    },
    "The SideStore background connection could not be created.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The SideStore background connection could not be created."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法创建 SideStore 后台连接，请重试。"
          }
        }
      }
    },
    "Unable to access SideStore's data container for background refresh.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to access SideStore's data container for background refresh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后台续签无法访问 SideStore 的数据目录，请打开内置 SideStore 后重试。"
          }
        }
      }
    },
    "Background refresh needs LiveProcess. Reinstall LiveContainer+SideStore and keep its app extensions.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Background refresh needs LiveProcess. Reinstall LiveContainer+SideStore and keep its app extensions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后台续签需要 LiveProcess。请重新安装 LiveContainer+SideStore，并保留应用扩展。"
          }
        }
      }
    },
    "LiveProcess could not start. Reinstall LiveContainer+SideStore and keep its app extensions.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveProcess could not start. Reinstall LiveContainer+SideStore and keep its app extensions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveProcess 无法启动。请重新安装 LiveContainer+SideStore，并保留应用扩展。"
          }
        }
      }
    },
    "Built-in SideStore failed to start in reasonable time": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Built-in SideStore failed to start in reasonable time"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内置 SideStore 启动超时，请打开应用后重试。"
          }
        }
      }
    },
    "Built-in SideStore quit unexpectedly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Built-in SideStore quit unexpectedly"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内置 SideStore 意外退出，请重试。"
          }
        }
      }
    },
    "Refresh Apps via Widget": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh Apps via Widget"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过小组件续签应用"
          }
        }
      }
    },
    "Refresh All Apps": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh All Apps"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "续签所有应用"
          }
        }
      }
    },
    "Refreshes your sideloaded apps to prevent them from expiring.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refreshes your sideloaded apps to prevent them from expiring."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "续签侧载应用，避免签名过期。"
          }
        }
      }
    },
    "The shortcut stopped waiting for SideStore. Refresh may still be running in the background. Keep the local VPN connected. Query this request's result or check Refresh Attempts in SideStore.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shortcut stopped waiting for SideStore. Refresh may still be running in the background. Keep the local VPN connected. Query this request's result or check Refresh Attempts in SideStore."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快捷指令已停止等待 SideStore，续签可能仍在后台进行。请保持本地 VPN 连接，查询本次续签结果，或到 SideStore 的刷新尝试记录中查看最终结果。"
          }
        }
      }
    },
    "SideStore did not start before the shortcut's background time limit. No refresh was started. Open LiveContainer and try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore did not start before the shortcut's background time limit. No refresh was started. Open LiveContainer and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore 未能在快捷指令的后台等待时限内启动，本次未开始续签。请打开 LiveContainer 后重试。"
          }
        }
      }
    },
    "All apps have been refreshed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All apps have been refreshed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有应用均已续签。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
